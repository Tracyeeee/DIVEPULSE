# ==========================================
# 数据库 - MySQL (使用 docker-compose 部署时)
# ==========================================
DATABASE_URL="mysql://divepulse:divepulse_password@localhost:3306/divepulse"

# ==========================================
# 数据库 - MySQL 环境变量 (仅 docker-compose 参考)
# ==========================================
# MYSQL_ROOT_PASSWORD=rootpassword
# MYSQL_DATABASE=divepulse
# MYSQL_USER=divepulse
# MYSQL_PASSWORD=divepulse_password
# MYSQL_PORT=3306

# ==========================================
# JWT 密钥 (生产环境请使用强密码)
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ==========================================
# 服务端口
# ==========================================
PORT=3000

# ==========================================
# 环境模式
# ==========================================
NODE_ENV=development

# ==========================================
# CORS 允许的源
# ==========================================
CORS_ORIGIN=http://localhost:5173
